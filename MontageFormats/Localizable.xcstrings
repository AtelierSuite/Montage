{
  "sourceLanguage" : "en",
  "strings" : {
    "AVIWriter.Error.InvalidSettings" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This video can't be exported as AVI at this frame size, frame rate or audio format."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフレームサイズ、フレームレート、またはオーディオフォーマットでは、このビデオをAVIとして書き出せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法以此画面尺寸、帧速率或音频格式将此视频导出为 AVI。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法以此畫面尺寸、影格速率或音訊格式將此影片輸出為 AVI。"
          }
        }
      }
    },
    "AVIWriter.Error.NotWriting" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The AVI file has already been finished or cancelled, so nothing more can be added to it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVIファイルはすでに完了またはキャンセルされているため、これ以上追加できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVI 文件已完成或已取消，无法再向其中添加内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVI 檔案已完成或已取消，無法再加入任何內容。"
          }
        }
      }
    },
    "AVIWriter.Error.TooLarge" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This video is too large to export as a single AVI file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビデオは大きすぎるため、1つのAVIファイルとして書き出せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此视频太大，无法导出为单个 AVI 文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此影片太大，無法輸出為單一 AVI 檔案。"
          }
        }
      }
    },
    "AVIWriter.Error.UnsupportedMedia" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some of the video or audio is in a format that can't be written into an AVI file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオまたはオーディオの一部が、AVIファイルに書き込めないフォーマットです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分视频或音频的格式无法写入 AVI 文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分影片或音訊的格式無法寫入 AVI 檔案。"
          }
        }
      }
    },
    "CubeLUT.Error.Unreadable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The look-up table couldn’t be read."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルックアップテーブルを読み込めませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取查找表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取查找表。"
          }
        }
      }
    },
    "CubeLUT.Error.Unsupported" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only 3D look-up tables from 0 to 1 can be used."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用できるのは、0から1の範囲の3Dルックアップテーブルのみです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅可使用范围为 0 到 1 的 3D 查找表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅可使用範圍為 0 到 1 的 3D 查找表。"
          }
        }
      }
    },
    "DRP.Error.Damaged" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This DaVinci Resolve project can’t be read because it’s damaged or incomplete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このDaVinci Resolveプロジェクトは破損しているか不完全なため、読み込めません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取此 DaVinci Resolve 项目，因为它已损坏或不完整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取此 DaVinci Resolve 專案，因為它已損毀或不完整。"
          }
        }
      }
    },
    "DRP.Error.ExportFCPXML" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In DaVinci Resolve, choose File > Export > Timeline, export the timeline as FCPXML, and import that file instead."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DaVinci Resolveで「ファイル」>「書き出し」>「タイムライン」を選択してタイムラインをFCPXMLとして書き出し、代わりにそのファイルを読み込んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在 DaVinci Resolve 中选取“文件”>“导出”>“时间线”，将时间线导出为 FCPXML，然后改为导入该文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在 DaVinci Resolve 中選擇「檔案」>「輸出」>「時間線」，將時間線輸出為 FCPXML，然後改為輸入該檔案。"
          }
        }
      }
    },
    "DRP.Error.NotAProject" : {
