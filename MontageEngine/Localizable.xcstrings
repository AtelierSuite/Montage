    "MediaProbe.Error.Unsupported.Suggestion" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montage imports movies, audio and images this device can play, such as MOV, MP4, M4A, MP3, JPEG, PNG and HEIC files. AVI files and protected media can’t be imported."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montageでは、このデバイスで再生できるムービー、オーディオ、イメージ（MOV、MP4、M4A、MP3、JPEG、PNG、HEICファイルなど）を読み込めます。AVIファイルと保護されたメディアは読み込めません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montage 可导入此设备能够播放的影片、音频和图像，例如 MOV、MP4、M4A、MP3、JPEG、PNG 和 HEIC 文件。无法导入 AVI 文件和受保护的媒体。"
          }
        }
      }
    }
  },
  "version" : "1.0"
