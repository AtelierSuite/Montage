    "Mac.Import.ReferenceInPlace.Help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the files from where they are now, rather than copying them into the project. Moving or deleting them breaks the project's link to them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルをプロジェクトにコピーせず、現在の場所から使用します。ファイルを移動または削除すると、プロジェクトからのリンクが切れます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从文件当前所在位置使用它们，而不是将其拷贝到项目中。移动或删除这些文件会断开项目与它们的链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從檔案目前所在位置使用它們，而不是將其拷貝到專案中。移動或刪除這些檔案會中斷專案與它們的連結。"
          }
        }
      }
    },
