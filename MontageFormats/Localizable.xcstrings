          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片段與另一個片段重疊，因此被移到了單獨的軌道。"
          }
        }
      }
    },
    "Interchange.Issue.NestedSettings" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The clip was inside a compound or multicam clip whose settings it had too, so its own were kept."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップは、同じ設定を持つ複合クリップまたはマルチカムクリップの中にあったため、クリップ自身の設定が保持されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片段位于复合片段或多机位片段中，而它们也有相同的设置，因此保留了片段自己的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片段位於複合片段或多機位片段中，而它們也有相同的設定，因此保留了片段自己的設定。"
          }
        }
      }
    },
