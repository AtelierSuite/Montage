        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montage 会将你导出的视频存储到你的照片图库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montage 會將你輸出的影片儲存到你的照片圖庫。"
          }
        }
