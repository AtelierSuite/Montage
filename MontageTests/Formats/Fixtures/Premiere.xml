<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE xmeml>
<!-- Made by hand in the shape Premiere Pro exports: an NTSC sequence with a
     dissolve between two clips, linked stereo sound, a clip above with a
     blur and a third-party effect, and a sound clip of its own. -->
<xmeml version="4">
    <sequence id="sequence-1">
        <name>Premiere Sequence</name>
        <duration>300</duration>
        <rate>
            <timebase>30</timebase>
            <ntsc>TRUE</ntsc>
        </rate>
        <media>
            <video>
                <format>
                    <samplecharacteristics>
                        <rate>
                            <timebase>30</timebase>
                            <ntsc>TRUE</ntsc>
                        </rate>
                        <width>1920</width>
                        <height>1080</height>
                    </samplecharacteristics>
                </format>
                <track>
                    <clipitem id="clipitem-1">
                        <name>Opening</name>
                        <enabled>TRUE</enabled>
                        <duration>600</duration>
                        <rate>
                            <timebase>30</timebase>
                            <ntsc>TRUE</ntsc>
                        </rate>
                        <start>0</start>
                        <end>-1</end>
                        <in>30</in>
                        <out>195</out>
                        <file id="file-1">
                            <name>IMG_1805.MOV</name>
                            <pathurl>file://localhost/Volumes/Footage/IMG_1805.MOV</pathurl>
                            <rate>
                                <timebase>30</timebase>
                                <ntsc>TRUE</ntsc>
                            </rate>
                            <duration>600</duration>
                            <media>
                                <video>
                                    <samplecharacteristics>
                                        <width>1920</width>
                                        <height>1080</height>
                                    </samplecharacteristics>
                                </video>
                                <audio>
                                    <samplecharacteristics>
                                        <depth>16</depth>
                                        <samplerate>48000</samplerate>
                                    </samplecharacteristics>
                                    <channelcount>2</channelcount>
                                </audio>
                            </media>
                        </file>
                        <filter>
                            <effect>
                                <name>Basic Motion</name>
                                <effectid>basic</effectid>
                                <effectcategory>motion</effectcategory>
                                <effecttype>motion</effecttype>
                                <mediatype>video</mediatype>
                                <parameter>
                                    <parameterid>scale</parameterid>
                                    <name>Scale</name>
                                    <value>50</value>
                                </parameter>
                                <parameter>
                                    <parameterid>rotation</parameterid>
                                    <name>Rotation</name>
                                    <value>15</value>
                                </parameter>
                                <parameter>
                                    <parameterid>center</parameterid>
                                    <name>Center</name>
                                    <value>
                                        <horiz>0.25</horiz>
                                        <vert>-0.25</vert>
                                    </value>
                                </parameter>
                            </effect>
                        </filter>
                        <filter>
                            <effect>
                                <name>Opacity</name>
                                <effectid>opacity</effectid>
                                <effectcategory>motion</effectcategory>
                                <effecttype>motion</effecttype>
                                <mediatype>video</mediatype>
                                <parameter>
                                    <parameterid>opacity</parameterid>
                                    <name>opacity</name>
                                    <value>100</value>
                                    <keyframe>
                                        <when>30</when>
                                        <value>0</value>
                                    </keyframe>
                                    <keyframe>
                                        <when>60</when>
                                        <value>80</value>
                                    </keyframe>
                                </parameter>
                            </effect>
                        </filter>
                        <link>
                            <linkclipref>clipitem-3</linkclipref>
                            <mediatype>audio</mediatype>
                        </link>
                    </clipitem>
                    <transitionitem>
                        <start>135</start>
                        <end>165</end>
                        <alignment>center</alignment>
                        <effect>
                            <name>Cross Dissolve</name>
                            <effectid>Cross Dissolve</effectid>
                            <effectcategory>Dissolve</effectcategory>
                            <effecttype>transition</effecttype>
                            <mediatype>video</mediatype>
                        </effect>
                    </transitionitem>
                    <clipitem id="clipitem-2">
                        <name>Second</name>
                        <enabled>TRUE</enabled>
                        <duration>600</duration>
                        <rate>
                            <timebase>30</timebase>
                            <ntsc>TRUE</ntsc>
                        </rate>
                        <start>-1</start>
                        <end>300</end>
                        <in>0</in>
                        <out>165</out>
                        <file id="file-2">
                            <name>IMG_1813.MOV</name>
                            <pathurl>file://localhost/Volumes/Footage/IMG_1813.MOV</pathurl>
                            <rate>
                                <timebase>30</timebase>
                                <ntsc>TRUE</ntsc>
                            </rate>
                            <duration>600</duration>
                            <media>
                                <video>
                                    <samplecharacteristics>
                                        <width>1920</width>
                                        <height>1080</height>
                                    </samplecharacteristics>
                                </video>
                                <audio>
                                    <channelcount>2</channelcount>
                                </audio>
                            </media>
                        </file>
                    </clipitem>
                    <generatoritem id="generator-1">
                        <name>Color Matte</name>
                        <start>300</start>
                        <end>330</end>
                        <effect>
                            <name>Color</name>
                            <effectid>Color</effectid>
                            <effecttype>generator</effecttype>
                        </effect>
                    </generatoritem>
                </track>
                <track>
                    <clipitem id="clipitem-5">
                        <name>Blurred</name>
                        <enabled>TRUE</enabled>
                        <rate>
                            <timebase>30</timebase>
                            <ntsc>TRUE</ntsc>
                        </rate>
                        <start>30</start>
                        <end>90</end>
                        <in>0</in>
                        <out>60</out>
                        <file id="file-3">
                            <name>IMG_3311.MOV</name>
                            <pathurl>file://localhost/Volumes/Footage/IMG_3311.MOV</pathurl>
                            <rate>
                                <timebase>30</timebase>
                                <ntsc>TRUE</ntsc>
                            </rate>
                            <duration>600</duration>
                            <media>
                                <video>
                                    <samplecharacteristics>
                                        <width>1920</width>
                                        <height>1080</height>
                                    </samplecharacteristics>
                                </video>
                            </media>
                        </file>
                        <filter>
                            <effect>
                                <name>Gaussian Blur</name>
                                <effectid>GaussianBlur</effectid>
                                <effectcategory>Blur</effectcategory>
                                <effecttype>filter</effecttype>
                                <mediatype>video</mediatype>
                                <parameter>
                                    <parameterid>blurriness</parameterid>
                                    <name>Blurriness</name>
                                    <value>9.6</value>
                                </parameter>
                            </effect>
                        </filter>
                        <filter>
                            <effect>
                                <name>Lumetri Color</name>
                                <effectid>Lumetri</effectid>
                                <effecttype>filter</effecttype>
                                <mediatype>video</mediatype>
                                <parameter>
                                    <parameterid>exposure</parameterid>
                                    <name>Exposure</name>
                                    <value>0.5</value>
                                </parameter>
                            </effect>
                        </filter>
                    </clipitem>
                </track>
            </video>
            <audio>
                <track>
                    <clipitem id="clipitem-3">
                        <name>Opening</name>
                        <enabled>TRUE</enabled>
                        <start>0</start>
                        <end>-1</end>
                        <in>30</in>
                        <out>195</out>
                        <file id="file-1"/>
                        <sourcetrack>
                            <mediatype>audio</mediatype>
                            <trackindex>1</trackindex>
                        </sourcetrack>
                        <filter>
                            <effect>
                                <name>Audio Levels</name>
                                <effectid>audiolevels</effectid>
                                <effectcategory>audiolevels</effectcategory>
                                <effecttype>audiolevels</effecttype>
                                <mediatype>audio</mediatype>
                                <parameter>
                                    <parameterid>level</parameterid>
                                    <name>Level</name>
                                    <value>0.5</value>
                                </parameter>
                            </effect>
                        </filter>
                    </clipitem>
                </track>
                <track>
                    <clipitem id="clipitem-4">
                        <name>Opening</name>
                        <enabled>TRUE</enabled>
                        <start>0</start>
                        <end>-1</end>
                        <in>30</in>
                        <out>195</out>
                        <file id="file-1"/>
                        <sourcetrack>
                            <mediatype>audio</mediatype>
                            <trackindex>2</trackindex>
                        </sourcetrack>
                    </clipitem>
                </track>
                <track>
                    <clipitem id="clipitem-6">
                        <name>Sound</name>
                        <enabled>TRUE</enabled>
                        <start>0</start>
                        <end>90</end>
                        <in>0</in>
                        <out>90</out>
                        <file id="file-4">
                            <name>IMG_1841.MOV</name>
                            <pathurl>file://localhost/Volumes/Footage/IMG_1841.MOV</pathurl>
                            <rate>
                                <timebase>30</timebase>
                                <ntsc>TRUE</ntsc>
                            </rate>
                            <duration>600</duration>
                            <media>
                                <audio>
                                    <channelcount>2</channelcount>
                                </audio>
                            </media>
                        </file>
                        <filter>
                            <effect>
                                <name>Audio Pan</name>
                                <effectid>audiopan</effectid>
                                <mediatype>audio</mediatype>
                                <parameter>
                                    <parameterid>pan</parameterid>
                                    <name>Pan</name>
                                    <value>-1</value>
                                </parameter>
                            </effect>
                        </filter>
                    </clipitem>
                </track>
            </audio>
        </media>
        <marker>
            <name>Chapter</name>
            <in>45</in>
            <out>-1</out>
        </marker>
    </sequence>
</xmeml>
