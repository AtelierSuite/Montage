{
  "sourceLanguage" : "en",
  "strings" : {
    "AVIWriter.Error.InvalidSettings" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This video can't be exported as AVI at this frame size, frame rate or audio format."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフレームサイズ、フレームレート、またはオーディオフォーマットでは、このビデオをAVIとして書き出せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法以此画面尺寸、帧速率或音频格式将此视频导出为 AVI。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法以此畫面尺寸、影格速率或音訊格式將此影片輸出為 AVI。"
          }
        }
      }
    },
    "AVIWriter.Error.NotWriting" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The AVI file has already been finished or cancelled, so nothing more can be added to it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVIファイルはすでに完了またはキャンセルされているため、これ以上追加できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVI 文件已完成或已取消，无法再向其中添加内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVI 檔案已完成或已取消，無法再加入任何內容。"
          }
        }
      }
    },
    "AVIWriter.Error.TooLarge" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This video is too large to export as a single AVI file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このビデオは大きすぎるため、1つのAVIファイルとして書き出せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此视频太大，无法导出为单个 AVI 文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此影片太大，無法輸出為單一 AVI 檔案。"
          }
        }
      }
    },
    "AVIWriter.Error.UnsupportedMedia" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some of the video or audio is in a format that can't be written into an AVI file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオまたはオーディオの一部が、AVIファイルに書き込めないフォーマットです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分视频或音频的格式无法写入 AVI 文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分影片或音訊的格式無法寫入 AVI 檔案。"
          }
        }
      }
    },
    "CubeLUT.Error.Unreadable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The look-up table couldn’t be read."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルックアップテーブルを読み込めませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取查找表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取查找表。"
          }
        }
      }
    },
    "CubeLUT.Error.Unsupported" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only 3D look-up tables from 0 to 1 can be used."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用できるのは、0から1の範囲の3Dルックアップテーブルのみです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅可使用范围为 0 到 1 的 3D 查找表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅可使用範圍為 0 到 1 的 3D 查找表。"
          }
        }
      }
    },
    "Interchange.Error.NoTimeline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There’s no project timeline in this file to import."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルには読み込めるプロジェクトのタイムラインがありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件中没有可导入的项目时间线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案中沒有可輸入的專案時間軸。"
          }
        }
      }
    },
    "Interchange.Error.Unreadable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The project file couldn’t be read. It may be damaged, or not finished being written."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトファイルを読み込めませんでした。ファイルが破損しているか、書き込みが完了していない可能性があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取项目文件。文件可能已损坏，或尚未写入完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取專案檔案。檔案可能已損毀，或尚未寫入完成。"
          }
        }
      }
    },
    "Interchange.Error.UnsupportedFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file isn’t a project Montage can import. Exporting FCPXML or Final Cut Pro 7 XML from the other editor is the most dependable way to bring a project in."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルはMontageで読み込めるプロジェクトではありません。元の編集アプリからFCPXMLまたはFinal Cut Pro 7 XMLを書き出して読み込むのが、最も確実な方法です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件不是 Montage 可导入的项目。从原来的剪辑应用导出 FCPXML 或 Final Cut Pro 7 XML 再导入，是最可靠的方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此檔案不是 Montage 可輸入的專案。從原本的剪輯 App 輸出 FCPXML 或 Final Cut Pro 7 XML 再輸入，是最可靠的方式。"
          }
        }
      }
    },
