          "stringUnit" : {
            "state" : "translated",
            "value" : "Videos you export are saved to your photo library."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き出したビデオはフォトライブラリに保存されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你导出的视频将存储到你的照片图库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你輸出的影片將儲存到你的照片圖庫。"
          }
