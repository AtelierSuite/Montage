    "Interchange.Issue.AuditionAlternatives" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the audition’s chosen clip was imported, without its %lld other picks."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディションで選択されたクリップのみが読み込まれ、ほかの%lld個の候補は読み込まれませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅导入了试演中选定的片段，其他 %lld 个备选未导入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅輸入了試演中選定的片段，其他 %lld 個備選未輸入。"
          }
        }
      }
    },
    "Interchange.Issue.BeforeMediaStart" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starts before its media’s timecode does, so it plays from the first frame of the media."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メディアのタイムコードより前から始まるため、メディアの最初のフレームから再生されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开始时间早于媒体的时间码，因此从媒体的第一帧开始播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始時間早於媒體的時間碼，因此從媒體的第一個影格開始播放。"
          }
        }
      }
    },
    "Interchange.Issue.Caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A caption was left out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャプションが除外されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个字幕被略去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一個字幕被略去。"
          }
        }
      }
    },
    "Interchange.Issue.DisabledClip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The clip was turned off, so it was left out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップがオフになっていたため、除外されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片段已关闭，因此被略去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片段已關閉，因此被略去。"
          }
        }
      }
    },
    "Interchange.Issue.FrameRateAssumed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EDLs don’t record a frame rate, so the timecode was read at %@ fps. If the project was at another rate, its cuts may be off."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EDLにはフレームレートが記録されていないため、タイムコードは%@ fpsとして読み込まれました。プロジェクトが別のフレームレートだった場合、カットの位置がずれることがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EDL 不记录帧速率，因此时间码按 %@ fps 读取。如果项目使用其他帧速率，剪切点可能会有偏差。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EDL 不會記錄影格速率，因此時間碼以 %@ fps 讀取。如果專案使用其他影格速率，剪接點可能會有偏差。"
          }
        }
      }
    },
    "Interchange.Issue.FrameRateFromMedia" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EDLs don’t record a frame rate, so the timecode was read at %@ fps, the frame rate of the media."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EDLにはフレームレートが記録されていないため、タイムコードはメディアのフレームレートである%@ fpsとして読み込まれました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EDL 不记录帧速率，因此时间码按媒体的帧速率 %@ fps 读取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EDL 不會記錄影格速率，因此時間碼以媒體的影格速率 %@ fps 讀取。"
          }
        }
      }
    },
