    "Interchange.Issue.AuditionAlternatives" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the audition’s chosen clip was imported, without its %lld other picks."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディションで選択されたクリップのみが読み込まれ、ほかの%lld個の候補は読み込まれませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅导入了试演中选定的片段，其他 %lld 个备选未导入。"
          }
        }
      }
    },
    "Interchange.Issue.Caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A caption was left out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャプションが除外されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个字幕被略去。"
          }
        }
      }
    },
    "Interchange.Issue.DisabledClip" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The clip was turned off, so it was left out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップがオフになっていたため、除外されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片段已关闭，因此被略去。"
          }
        }
      }
    },
    "Interchange.Issue.Generator" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The generator “%@” was left out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジェネレータ「%@」が除外されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成器“%@”被略去。"
          }
        }
      }
    },
    "Interchange.Issue.Marker" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A marker was left out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マーカーが除外されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个标记被略去。"
          }
        }
      }
    },
    "Interchange.Issue.MarkerNamed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The marker “%@” was left out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マーカー「%@」が除外されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标记“%@”被略去。"
          }
        }
      }
    },
    "Interchange.Issue.MissingMedia" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file wasn’t found at %@. Relink it to play the clips made from it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にファイルが見つかりませんでした。このファイルから作成したクリップを再生するには、再リンクしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %@ 找不到文件。请重新链接，以播放由它制作的片段。"
          }
        }
      }
    },
    "Interchange.Issue.MovedToNewTrack" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The clip overlapped another, so it was moved to a track of its own."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップがほかのクリップと重なっていたため、専用のトラックに移動されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片段与另一个片段重叠，因此被移到了单独的轨道。"
          }
        }
      }
    },
    "Interchange.Issue.NestedSettings" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The clip was inside a compound or multicam clip whose settings it had too, so its own were kept."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップは、同じ設定を持つ複合クリップまたはマルチカムクリップの中にあったため、クリップ自身の設定が保持されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片段位于复合片段或多机位片段中，而它们也有相同的设置，因此保留了片段自己的设置。"
          }
        }
      }
    },
    "Interchange.Issue.OtherTimelines" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the first timeline was imported; the file has %lld more."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初のタイムラインのみが読み込まれました。ファイルにはほかに%lld個のタイムラインがあります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅导入了第一条时间线；文件中还有 %lld 条。"
          }
        }
      }
    },
    "Interchange.Issue.Setting" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has no match in Montage, so it was left out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」に相当するものがMontageにないため、除外されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montage 中没有与“%@”对应的功能，因此被略去。"
          }
        }
      }
    },
    "Interchange.Issue.SpeedChange" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The clip’s speed change was left out, so it plays at normal speed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップの速度変更が除外されたため、通常の速度で再生されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片段的速度变化被略去，因此会以正常速度播放。"
          }
        }
      }
    },
    "Interchange.Issue.Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A title was left out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトルが除外されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个标题被略去。"
          }
        }
      }
    },
    "Interchange.Issue.TitleText" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The title “%@” was left out."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトル「%@」が除外されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标题“%@”被略去。"
          }
        }
      }
    },
    "Interchange.Issue.Transition" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The transition “%@” was replaced with a cut halfway through it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トランジション「%@」は、その中間点でのカットに置き換えられました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转场“%@”被替换为在其中点处的直接切换。"
          }
        }
      }
    },
    "Interchange.Issue.Uneven" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was different across and down, so the across value was used for both."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」の横方向と縦方向の値が異なっていたため、横方向の値が両方に使用されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”的横向和纵向值不同，因此两者都使用了横向值。"
          }
        }
      }
    },
    "Interchange.Issue.UnsupportedEffect" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” has no match in Montage. It’s kept on the clip, turned off."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」に相当するものがMontageにありません。クリップ上にオフの状態で保持されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montage 中没有与“%@”对应的效果。它会以关闭状态保留在片段上。"
          }
        }
      }
    },
    "ProjectPackage.Error.NewerFormat" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This project was saved by a newer version of Montage. Update Montage to open it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロジェクトは新しいバージョンのMontageで保存されました。開くにはMontageをアップデートしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此项目由更新版本的 Montage 存储。请更新 Montage 以打开它。"
          }
        }
      }
    },
    "ProjectPackage.Error.Unreadable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This file isn't a Montage project, or it's damaged."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルはMontageプロジェクトではないか、破損しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件不是 Montage 项目，或已损坏。"
          }
        }
      }
    }
