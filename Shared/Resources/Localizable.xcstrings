    "Relink.Message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These files can't be found. Their clips stay on the timeline, and play as empty time, until they're relinked. Search a folder or choose files to find them by name, or locate each one yourself."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのファイルが見つかりません。再リンクするまで、クリップはタイムライン上に残り、空の時間として再生されます。フォルダを検索するかファイルを選択して名前で探すか、1つずつ場所を指定してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到这些文件。在重新链接之前，它们的片段会保留在时间线上，并作为空白时间播放。搜索文件夹或选取文件以按名称查找，或者自己逐一定位。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到這些檔案。在重新連結之前，它們的片段會保留在時間軸上，並作為空白時間播放。搜尋檔案夾或選擇檔案以按名稱尋找，或者自己逐一尋找。"
          }
        }
      }
    },
